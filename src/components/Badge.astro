---
import {
  BADGE_COLORS,
  BADGE_SIZES,
  type BadgeColor,
  type BadgeSize,
} from "../lib/badge-colors.ts";

interface Props {
  color?: BadgeColor;
  size?: BadgeSize;
  class?: string;
}

const { color = "blue", size = "md", class: className = "" } = Astro.props;
---

<span class={`${BADGE_SIZES[size]} ${BADGE_COLORS[color]} ${className}`}>
  <slot />
</span>
