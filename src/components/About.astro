---
import Section from "./Section.astro";
import { DISPLAY_NAMES, type Locale } from "../i18n/locales.ts";
import type { Dictionary } from "../i18n/dictionary.ts";
import { formatTemplate } from "../i18n/index.ts";

interface Props {
	locale?: Locale;
	about?: Dictionary["about"];
}

const { locale = "en", about } = Astro.props;
const title = about?.title ?? "About Me";
const greeting = formatTemplate(
	about?.greetingTemplate ??
		"Hi! I'm {name}, a Software Engineer based in Tokyo.",
	{ name: DISPLAY_NAMES[locale] },
);
const paragraphs = about?.paragraphs ?? [];
---

<Section id="about" title={title} variant="muted">
	<div class="prose prose-slate dark:prose-invert max-w-none">
		<p class="about-text font-serif">
			{greeting}
		</p>
		{
			paragraphs.map((paragraph) => (
				<p class="about-text mt-1 font-serif">{paragraph}</p>
			))
		}
	</div>
</Section>

<style>
	@reference "../styles/global.css";

	.about-text {
		@apply text-lg text-slate-600 dark:text-slate-300 leading-relaxed;
	}

	.about-emphasis {
		@apply text-slate-900 dark:text-white;
	}
</style>
