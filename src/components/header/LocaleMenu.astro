---
import { Icon } from "astro-icon/components";
import { LOCALES, type Locale } from "../../i18n/locales.ts";

interface Props {
  locale?: Locale;
  languageLabel?: string;
  storageKey?: string;
}

const {
  locale,
  languageLabel = "Language",
  storageKey = "locale",
} = Astro.props;
---

<div class="relative">
  <button
    id="locale-toggle"
    class="h-11 w-11 shrink-0 rounded-full bg-slate-100/80 dark:bg-slate-800/80 backdrop-blur flex items-center justify-center text-slate-700 dark:text-slate-200 border border-slate-200/60 dark:border-slate-700/60 hover:bg-slate-200/80 dark:hover:bg-slate-700/80 active:scale-95 transition-all"
    aria-label={languageLabel}
    aria-haspopup="true"
    aria-expanded="false"
  >
    <Icon name="lucide:globe" class="h-5 w-5" />
  </button>
  <div
    id="locale-menu"
    class="hidden absolute right-0 mt-2 w-40 overflow-hidden rounded-2xl border border-slate-200/60 dark:border-slate-700/60 bg-white/90 dark:bg-slate-800/90 backdrop-blur shadow-xl p-1.5"
    role="menu"
  >
    {
      LOCALES.map((entry) => (
        <a
          href={entry.path}
          role="menuitem"
          data-locale={entry.code}
          aria-current={entry.code === locale ? "true" : undefined}
          class={`flex items-center justify-between gap-2 rounded-xl px-3 py-2.5 text-sm transition-all hover:bg-slate-100 dark:hover:bg-slate-700/70 active:scale-[0.99] ${
            entry.code === locale
              ? "text-slate-900 dark:text-white font-semibold"
              : "text-slate-600 dark:text-slate-300"
          }`}
        >
          <span>{entry.fullName}</span>
          {entry.code === locale && (
            <Icon
              name="lucide:check"
              class="h-4 w-4 shrink-0 text-slate-900 dark:text-white"
            />
          )}
        </a>
      ))
    }
  </div>
</div>

<script define:vars={{ storageKey }}>
  import { initLocaleMenu } from "../../scripts/locale-menu.ts";

  initLocaleMenu(storageKey);
</script>
