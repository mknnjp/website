---
import { Icon } from "astro-icon/components";
---

<button
  id="theme-toggle"
  class="h-11 w-11 shrink-0 rounded-full bg-slate-100/80 dark:bg-slate-800/80 backdrop-blur flex items-center justify-center text-slate-700 dark:text-slate-200 border border-slate-200/60 dark:border-slate-700/60 hover:bg-slate-200/80 dark:hover:bg-slate-700/80 active:scale-95 transition-all"
  aria-label="Toggle theme"
>
  <Icon name="lucide:sun" id="theme-icon-sun" class="h-5 w-5" />
  <Icon name="lucide:moon" id="theme-icon-moon" class="h-5 w-5 hidden" />
</button>

<script>
  import { initThemeToggle } from "../../scripts/theme-toggle.ts";

  initThemeToggle();
</script>
