---
import { Icon } from "astro-icon/components";
---

<button
  id="theme-toggle"
  class="p-2 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
  aria-label="Toggle theme"
>
  <Icon name="lucide:sun" id="theme-icon-sun" class="h-5 w-5" />
  <Icon name="lucide:moon" id="theme-icon-moon" class="h-5 w-5 hidden" />
</button>

<script>
  import { initThemeToggle } from "../../scripts/theme-toggle.ts";

  initThemeToggle();
</script>
