---
import NavLinks from "./NavLinks.astro";
import type { Dictionary } from "../../i18n/dictionary.ts";

interface Props {
  nav?: Dictionary["nav"];
  navLabel?: string;
}

const { nav, navLabel = "Site navigation" } = Astro.props;
---

<div
  id="mobile-menu"
  class="hidden fixed inset-0 z-40 md:hidden bg-white/95 dark:bg-slate-900/95 backdrop-blur-md transition-transform duration-300 ease-out translate-x-full motion-reduce:transition-none"
  role="dialog"
  aria-modal="true"
  aria-hidden="true"
  aria-label={navLabel}
>
  <NavLinks nav={nav} variant="mobile" navLabel={navLabel} />
</div>
