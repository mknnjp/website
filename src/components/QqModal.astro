---
import type { Dictionary } from "../i18n/dictionary.ts";

type QrModalLabels = Pick<Dictionary["qqModal"], "closeLabel" | "qrAlt">;

type QrModalDefinition = {
  id: "qq" | "wechat";
  labels: QrModalLabels;
  imageSrc: string;
  darkImageSrc?: string;
};

interface Props {
  qqModal?: Dictionary["qqModal"];
  wechatModal?: Dictionary["wechatModal"];
}

const { qqModal, wechatModal } = Astro.props;

const qrModals: readonly QrModalDefinition[] = [
  {
    id: "qq",
    labels: {
      closeLabel: qqModal?.closeLabel ?? "Close QQ QR code dialog",
      qrAlt: qqModal?.qrAlt ?? "QQ QR code",
    },
    imageSrc: "/qq_light.jpeg",
    darkImageSrc: "/qq_dark.jpeg",
  },
  {
    id: "wechat",
    labels: {
      closeLabel: wechatModal?.closeLabel ?? "Close WeChat QR code dialog",
      qrAlt: wechatModal?.qrAlt ?? "WeChat QR code",
    },
    imageSrc: "/wechat.jpg",
  },
];
---

{
  qrModals.map(({ id, labels, imageSrc, darkImageSrc }) => (
    <dialog
      id={`${id}-modal`}
      data-qr-modal={id}
      aria-labelledby={`${id}-modal-title`}
      class="m-auto w-[calc(100%-2rem)] max-w-sm rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-xl backdrop:bg-slate-900/50 backdrop:backdrop-blur-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
    >
      <div class="max-h-[80vh] overflow-y-auto p-6 sm:p-8">
        <div class="mb-6 flex items-start justify-between gap-4">
          <div>
            <h2 id={`${id}-modal-title`} class="sr-only">
              {labels.qrAlt}
            </h2>
          </div>
          <button
            data-qr-close
            type="button"
            aria-label={labels.closeLabel}
            class="rounded-lg bg-slate-100 p-2 text-slate-600 transition-colors hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
              aria-hidden="true"
            >
              <path d="M18 6 6 18" />
              <path d="m6 6 12 12" />
            </svg>
          </button>
        </div>

        <div class="flex justify-center">
          <img
            src={imageSrc}
            alt={labels.qrAlt}
            class={
              darkImageSrc
                ? "h-auto max-w-full rounded-lg dark:hidden"
                : "h-auto max-w-full rounded-lg"
            }
          />
          {darkImageSrc ? (
            <img
              src={darkImageSrc}
              alt=""
              aria-hidden="true"
              class="hidden h-auto max-w-full rounded-lg dark:block"
            />
          ) : null}
        </div>
      </div>
    </dialog>
  ))
}

<script>
  const isDialog = (element: Element | null): element is HTMLDialogElement =>
    element instanceof HTMLDialogElement;

  document.querySelectorAll("[data-qr-modal]").forEach((element) => {
    if (!isDialog(element)) return;

    const modalId = element.dataset.qrModal;
    if (!modalId) return;

    document
      .querySelectorAll(`[data-qr-open="${modalId}"]`)
      .forEach((button) => {
        button.addEventListener("click", () => {
          element.showModal();
        });
      });

    element.querySelector("[data-qr-close]")?.addEventListener("click", () => {
      element.close();
    });

    element.addEventListener("click", (event) => {
      if (event.target === element) element.close();
    });
  });
</script>
