---
import Container from "./Container.astro";
import SocialLinks from "./SocialLinks.astro";
import { AVATAR_URL } from "../lib/site.ts";
import { DISPLAY_NAMES, type Locale } from "../i18n/locales.ts";
import type { Dictionary } from "../i18n/dictionary.ts";

interface Props {
	locale?: Locale;
	hero?: Dictionary["hero"];
	qqModal?: Dictionary["qqModal"];
	emailModal?: Dictionary["emailModal"];
}

const { locale = "en", hero, qqModal, emailModal } = Astro.props;
const displayName = DISPLAY_NAMES[locale];
const subtitle =
	hero?.subtitle ??
	"Software Engineer based in Tokyo, focusing on web and mobile application development.";
const avatarAlt = hero?.avatarAlt ?? displayName;
---

<section class="min-h-screen flex items-center justify-center pt-16">
	<Container class="py-20 text-center">
		<div class="avatar-frame relative inline-block mb-8 rounded-full shadow-xl">
			<div class="avatar-shimmer">
				<img
					src={AVATAR_URL}
					alt={avatarAlt}
					class="block w-32 h-32 rounded-full object-cover border-4 border-slate-200 dark:border-slate-700"
				/>
			</div>
		</div>
		<h1
			class="heading-shimmer relative block w-fit mx-auto mb-4 whitespace-nowrap text-5xl md:text-6xl font-extrabold"
			data-text={displayName}
		>
			<span class="text-yellow-400 dark:text-yellow-200">{displayName}</span>
		</h1>
		<p
			class="text-xl text-slate-600 dark:text-slate-300 mb-8 max-w-2xl mx-auto"
		>
			{subtitle}
		</p>
		<SocialLinks
			variant="hero"
			locale={locale}
			qqModal={qqModal}
			emailModal={emailModal}
		/>
	</Container>
</section>

<style>
	.avatar-frame {
		line-height: 0;
	}

	.avatar-shimmer {
		position: relative;
		display: block;
		border-radius: 9999px;
	}

	.avatar-shimmer::after,
	.heading-shimmer::after {
		background: linear-gradient(
			100deg,
			transparent 20%,
			rgba(255, 255, 255, 0.35) 38%,
			rgba(255, 255, 255, 0.7) 50%,
			rgba(255, 255, 255, 0.35) 62%,
			transparent 80%
		);
		background-size: 250% 100%;
		background-position: 130% 0;
		pointer-events: none;
		animation: shimmer 2.8s linear infinite;
	}

	.avatar-shimmer::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		overflow: hidden;
	}

	.heading-shimmer {
		position: relative;
		display: block;
	}

	.heading-shimmer::after {
		content: attr(data-text);
		position: absolute;
		inset: 0;
		color: transparent;
		-webkit-text-fill-color: transparent;
		-webkit-background-clip: text;
		background-clip: text;
		white-space: nowrap;
		font: inherit;
		line-height: inherit;
	}

	:global(.dark) .avatar-shimmer::after,
	:global(.dark) .heading-shimmer::after {
		opacity: 0.65;
	}

	@keyframes shimmer {
		from {
			background-position: 130% 0;
		}

		to {
			background-position: -30% 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.avatar-shimmer::after,
		.heading-shimmer::after {
			animation: none;
			opacity: 0.15;
		}
	}
</style>
