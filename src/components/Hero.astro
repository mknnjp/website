---
import Container from "./Container.astro";
import ExternalLink from "./ExternalLink.astro";
import SocialIcon from "./SocialIcon.astro";
import { SOCIAL_LINKS } from "../lib/social.ts";
import { AVATAR_URL } from "../lib/site.ts";
import { DISPLAY_NAMES, type Locale } from "../i18n/locales.ts";
import type { Dictionary } from "../i18n/dictionary.ts";

interface Props {
	locale?: Locale;
	hero?: Dictionary["hero"];
	qqModal?: Dictionary["qqModal"];
	emailModal?: Dictionary["emailModal"];
}

const { locale = "en", hero, qqModal, emailModal } = Astro.props;
const displayName = DISPLAY_NAMES[locale];
const subtitle =
	hero?.subtitle ??
	"Software Engineer based in Tokyo, focusing on web and mobile application development.";
const avatarAlt = hero?.avatarAlt ?? displayName;
const qqOpenLabel = qqModal?.openLabel ?? "Show QQ QR code";
const emailOpenLabel = emailModal?.openLabel ?? "Show email address";
---

<section class="min-h-screen flex items-center justify-center pt-16">
	<Container class="py-20 text-center">
		<div class="avatar-frame relative inline-block mb-8 rounded-full shadow-xl">
			<div class="avatar-shimmer">
				<img
					src={AVATAR_URL}
					alt={avatarAlt}
					class="block w-32 h-32 rounded-full object-cover border-4 border-slate-200 dark:border-slate-700"
				/>
			</div>
		</div>
		<h1
			class="heading-shimmer relative block w-fit mx-auto mb-4 whitespace-nowrap text-5xl md:text-6xl font-extrabold"
			data-text={displayName}
		>
			<span class="text-yellow-400 dark:text-yellow-200">{displayName}</span>
		</h1>
		<p
			class="text-xl text-slate-600 dark:text-slate-300 mb-8 max-w-2xl mx-auto"
		>
			{subtitle}
		</p>
		<div class="flex flex-wrap justify-center gap-4 mb-8">
			{
				SOCIAL_LINKS.map((link) => {
					if (link.modal === "qq") {
						return (
							<button
								type="button"
								data-qq-open
								aria-label={qqOpenLabel}
								class="flex items-center gap-2 px-5 py-2.5 bg-slate-100 dark:bg-slate-800 rounded-lg text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
							>
								<SocialIcon
									icon={link.icon}
									imgSrc={link.imgSrc}
									label={link.label}
								/>
								{link.label}
							</button>
						);
					}
					if (link.modal === "email") {
						return (
							<button
								type="button"
								data-email-open
								aria-label={emailOpenLabel}
								class="flex items-center gap-2 px-5 py-2.5 bg-slate-100 dark:bg-slate-800 rounded-lg text-slate-700 dark:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700 transition-colors"
							>
								<SocialIcon
									icon={link.icon}
									imgSrc={link.imgSrc}
									label={link.label}
								/>
								{link.label}
							</button>
						);
					}
					return (
						<ExternalLink
							href={link.href!}
							ariaLabel={link.label}
							variant="pill"
						>
							<SocialIcon
								icon={link.icon}
								imgSrc={link.imgSrc}
								label={link.label}
							/>
							{link.label}
						</ExternalLink>
					);
				})
			}
		</div>
	</Container>
</section>

<style>
	.avatar-frame {
		line-height: 0;
	}

	.avatar-shimmer {
		position: relative;
		display: block;
		border-radius: 9999px;
	}

	.avatar-shimmer::after,
	.heading-shimmer::after {
		background: linear-gradient(
			100deg,
			transparent 20%,
			rgba(255, 255, 255, 0.35) 38%,
			rgba(255, 255, 255, 0.7) 50%,
			rgba(255, 255, 255, 0.35) 62%,
			transparent 80%
		);
		background-size: 250% 100%;
		background-position: 130% 0;
		pointer-events: none;
		animation: shimmer 2.8s linear infinite;
	}

	.avatar-shimmer::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		overflow: hidden;
	}

	.heading-shimmer {
		position: relative;
		display: block;
	}

	.heading-shimmer::after {
		content: attr(data-text);
		position: absolute;
		inset: 0;
		color: transparent;
		-webkit-text-fill-color: transparent;
		-webkit-background-clip: text;
		background-clip: text;
		white-space: nowrap;
		font: inherit;
		line-height: inherit;
	}

	:global(.dark) .avatar-shimmer::after,
	:global(.dark) .heading-shimmer::after {
		opacity: 0.65;
	}

	@keyframes shimmer {
		from {
			background-position: 130% 0;
		}

		to {
			background-position: -30% 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.avatar-shimmer::after,
		.heading-shimmer::after {
			animation: none;
			opacity: 0.15;
		}
	}
</style>
