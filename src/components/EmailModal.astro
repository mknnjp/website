---
import { Icon } from "astro-icon/components";
import { EMAIL } from "../lib/site.ts";
import type { Dictionary } from "../i18n/dictionary.ts";

interface Props {
  emailModal?: Dictionary["emailModal"];
}

const { emailModal } = Astro.props;

const title = emailModal?.title ?? "Email";
const description =
  emailModal?.description ?? "Feel free to reach out via email.";
const closeLabel = emailModal?.closeLabel ?? "Close email dialog";
const copyLabel = emailModal?.copyLabel ?? "Copy";
const copiedLabel = emailModal?.copiedLabel ?? "Copied!";
const composeLabel = emailModal?.composeLabel ?? "Compose email";
const addressLabel = emailModal?.addressLabel ?? "Email address";
const emailHref = `mailto:${EMAIL}`;
---

<dialog
  id="email-modal"
  aria-labelledby="email-modal-title"
  class="m-auto w-[calc(100%-2rem)] max-w-sm rounded-2xl border border-slate-200 bg-white p-0 text-slate-900 shadow-xl backdrop:bg-slate-900/50 backdrop:backdrop-blur-sm dark:border-slate-700 dark:bg-slate-900 dark:text-slate-100"
>
  <div class="max-h-[80vh] overflow-y-auto p-6 sm:p-8">
    <div class="mb-6 flex items-start justify-between gap-4">
      <div>
        <h2
          id="email-modal-title"
          class="text-xl font-bold text-slate-900 dark:text-white"
        >
          {title}
        </h2>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
          {description}
        </p>
      </div>
      <button
        id="email-close"
        type="button"
        aria-label={closeLabel}
        class="rounded-lg bg-slate-100 p-2 text-slate-600 transition-colors hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-5 w-5"
          aria-hidden="true"
        >
          <path d="M18 6 6 18"></path>
          <path d="m6 6 12 12"></path>
        </svg>
      </button>
    </div>

    <div
      class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-700 dark:bg-slate-800/60"
    >
      <span
        class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-slate-900 text-white dark:bg-white dark:text-slate-900"
        aria-hidden="true"
      >
        <Icon name="lucide:mail" class="h-5 w-5" />
      </span>
      <div class="min-w-0 flex-1">
        <p
          class="text-xs font-medium uppercase tracking-wider text-slate-500 dark:text-slate-400"
        >
          {addressLabel}
        </p>
        <p
          id="email-address"
          class="truncate text-sm font-semibold text-slate-900 dark:text-white"
        >
          {EMAIL}
        </p>
      </div>
      <button
        id="email-copy"
        type="button"
        data-copy-label={copyLabel}
        data-copied-label={copiedLabel}
        class="flex shrink-0 items-center gap-1.5 rounded-lg bg-slate-900 px-3 py-2 text-sm font-medium text-white transition-colors hover:bg-slate-700 dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-4 w-4"
          aria-hidden="true"
        >
          <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
          ></path>
        </svg>
        <span id="email-copy-text">{copyLabel}</span>
      </button>
    </div>
    <p id="email-status" aria-live="polite" class="sr-only"></p>

    <div class="mt-4 flex justify-end">
      <a
        href={emailHref}
        class="inline-flex items-center gap-2 rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-100 dark:border-slate-600 dark:text-slate-200 dark:hover:bg-slate-800"
      >
        <Icon name="lucide:send" class="h-4 w-4" />
        {composeLabel}
      </a>
    </div>
  </div>
</dialog>

<script>
  const modal = document.getElementById("email-modal");
  const openButtons = document.querySelectorAll("[data-email-open]");
  const closeButton = document.getElementById("email-close");
  const copyButton = document.getElementById("email-copy");
  const copyText = document.getElementById("email-copy-text");
  const addressElement = document.getElementById("email-address");
  const statusElement = document.getElementById("email-status");

  const isDialog = (element: Element | null): element is HTMLDialogElement =>
    element instanceof HTMLDialogElement;

  openButtons.forEach((button) => {
    button.addEventListener("click", () => {
      if (isDialog(modal)) modal.showModal();
    });
  });

  closeButton?.addEventListener("click", () => {
    if (isDialog(modal)) modal.close();
  });

  modal?.addEventListener("click", (event) => {
    if (isDialog(modal) && event.target === modal) modal.close();
  });

  let revertTimer: number | undefined;

  const showCopied = () => {
    if (!(copyButton instanceof HTMLButtonElement)) return;
    const copiedLabel = copyButton.dataset.copiedLabel ?? "Copied!";
    if (copyText) copyText.textContent = copiedLabel;
    if (statusElement) statusElement.textContent = copiedLabel;
    window.clearTimeout(revertTimer);
    revertTimer = window.setTimeout(() => {
      const copyLabel = copyButton.dataset.copyLabel ?? "Copy";
      if (copyText) copyText.textContent = copyLabel;
      if (statusElement) statusElement.textContent = "";
    }, 2000);
  };

  const copyFallback = (value: string): boolean => {
    const textarea = document.createElement("textarea");
    textarea.value = value;
    textarea.setAttribute("readonly", "");
    textarea.style.position = "fixed";
    textarea.style.opacity = "0";
    document.body.appendChild(textarea);
    textarea.select();
    let succeeded = false;
    try {
      succeeded = document.execCommand("copy");
    } catch {
      succeeded = false;
    }
    textarea.remove();
    return succeeded;
  };

  copyButton?.addEventListener("click", async () => {
    const email = addressElement?.textContent?.trim() ?? "";
    if (!email) return;
    try {
      if (navigator.clipboard?.writeText) {
        await navigator.clipboard.writeText(email);
      } else if (!copyFallback(email)) {
        return;
      }
    } catch {
      if (!copyFallback(email)) return;
    }
    showCopied();
  });
</script>
