---
import TechBadge from "./TechBadge.astro";
import { Icon } from "astro-icon/components";
import type { TechItem, TechCategory } from "../lib/tech-stack.ts";

interface Props {
  category: TechCategory;
  title: string;
  items: TechItem[];
}

const { category, title, items } = Astro.props;

// Category icon mapping for visual hierarchy
const categoryIcons: Record<TechCategory, string> = {
  languages: "lucide:code",
  frameworksTools: "lucide:box",
  other: "lucide:more-horizontal",
};
---

<div class="mb-10 last:mb-0">
  <div class="flex items-center gap-2 mb-4">
    <Icon name={categoryIcons[category]} class="h-5 w-5 text-slate-500 dark:text-slate-400" aria-hidden="true" />
    <h3 class="text-xl font-semibold text-slate-800 dark:text-slate-200">{title}</h3>
  </div>
  <div class="flex flex-wrap gap-3">
    {items.map((item) => (
      <TechBadge item={item} size="md" />
    ))}
  </div>
</div>