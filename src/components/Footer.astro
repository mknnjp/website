---
import Container from "./Container.astro";
import LicensesModal from "./LicensesModal.astro";
import QqModal from "./QqModal.astro";
import EmailModal from "./EmailModal.astro";
import SocialLinks from "./SocialLinks.astro";
import { COPYRIGHT_YEAR } from "../lib/site.ts";
import { DISPLAY_NAMES, type Locale } from "../i18n/locales.ts";
import type { Dictionary } from "../i18n/dictionary.ts";

interface Props {
	locale?: Locale;
	footer?: Dictionary["footer"];
	licensesModal?: Dictionary["licensesModal"];
	qqModal?: Dictionary["qqModal"];
	emailModal?: Dictionary["emailModal"];
}

const {
	locale = "en",
	footer,
	licensesModal,
	qqModal,
	emailModal,
} = Astro.props;
const displayName = DISPLAY_NAMES[locale];
const rightsSuffix = footer?.rightsSuffix ?? "All rights reserved.";
const licensesButton = footer?.licensesButton ?? "Third-party licenses";
---

<footer class="py-12 border-t border-slate-200 dark:border-slate-800">
	<Container>
		<div class="flex flex-col md:flex-row justify-between items-center">
			<div class="flex flex-col items-center md:items-start gap-1 mb-4 md:mb-0">
				<p class="text-sm text-slate-500 dark:text-slate-400">
					&copy; {COPYRIGHT_YEAR} mknnjp. {rightsSuffix}
				</p>
				<button
					id="licenses-open"
					type="button"
					class="text-sm text-slate-500 dark:text-slate-400 underline decoration-slate-300 dark:decoration-slate-600 underline-offset-2 hover:text-slate-900 dark:hover:text-white transition-colors"
				>
					{licensesButton}
				</button>
			</div>
			<SocialLinks
				variant="footer"
				locale={locale}
				qqModal={qqModal}
				emailModal={emailModal}
			/>
		</div>
	</Container>
	<LicensesModal licensesModal={licensesModal} />
	<QqModal qqModal={qqModal} />
	<EmailModal emailModal={emailModal} />
</footer>
