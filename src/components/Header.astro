---
import Container from "./Container.astro";
import LocaleMenu from "./header/LocaleMenu.astro";
import MobileMenuPanel from "./header/MobileMenuPanel.astro";
import MobileMenuToggle from "./header/MobileMenuToggle.astro";
import NavLinks from "./header/NavLinks.astro";
import ThemeToggle from "./header/ThemeToggle.astro";
import { SITE_NAME } from "../lib/site.ts";
import {
	DEFAULT_LOCALE,
	LOCALE_STORAGE_KEY,
	type Locale,
} from "../i18n/locales.ts";
import type { Dictionary } from "../i18n/dictionary.ts";

interface Props {
	locale?: Locale;
	nav?: Dictionary["nav"];
	languageLabel?: string;
}

const {
	locale = DEFAULT_LOCALE,
	nav,
	languageLabel = "Language",
} = Astro.props;

const menuText =
	locale === "ja"
		? {
				open: "メニューを開く",
				close: "メニューを閉じる",
				nav: "サイトナビゲーション",
			}
		: locale === "zh-cn"
			? { open: "打开菜单", close: "关闭菜单", nav: "网站导航" }
			: { open: "Open menu", close: "Close menu", nav: "Site navigation" };
---

<header
	class="fixed top-0 left-0 right-0 z-50 bg-white/80 dark:bg-slate-900/80 backdrop-blur-sm border-b border-slate-200 dark:border-slate-800"
>
	<Container class="py-4 flex justify-between items-center gap-2">
		<a
			href="#"
			class="text-xl font-bold text-slate-900 dark:text-white shrink-0 truncate"
			>{SITE_NAME}</a
		>
		<div class="flex items-center gap-2 min-w-0">
			<NavLinks nav={nav} variant="desktop" navLabel={menuText.nav} />
			<div class="flex items-center gap-2">
				<ThemeToggle />
				<LocaleMenu
					locale={locale}
					languageLabel={languageLabel}
					storageKey={LOCALE_STORAGE_KEY}
				/>
				<MobileMenuToggle
					openLabel={menuText.open}
					closeLabel={menuText.close}
				/>
			</div>
		</div>
	</Container>
</header>
<MobileMenuPanel nav={nav} navLabel={menuText.nav} />

<script>
	import { initLocaleMenu } from "../scripts/locale-menu.ts";
	import { initMobileMenu } from "../scripts/mobile-menu.ts";
	import { LOCALE_STORAGE_KEY } from "../i18n/locales.ts";

	const toggle = document.getElementById("mobile-menu-toggle");

	initLocaleMenu(LOCALE_STORAGE_KEY);
	initMobileMenu({
		openLabel: toggle?.getAttribute("data-open-label") ?? "Open menu",
		closeLabel: toggle?.getAttribute("data-close-label") ?? "Close menu",
		closeDelay: 300,
		desktopQuery: "(min-width: 768px)",
	});
</script>
