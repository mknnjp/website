{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mknnjp-website",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client/",
    "binding": "ASSETS"
  }
}
